# Public URL of the Laravel API. Used by the browser for form submissions.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public URL of this site. Used for canonical links, the sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional private URL for server-side API calls, for example when both apps share a network.
API_INTERNAL_URL=

# Shared with the backend's FRONTEND_REVALIDATE_SECRET so admin edits appear immediately.
REVALIDATE_SECRET=
